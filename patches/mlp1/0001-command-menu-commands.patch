+bool command_save_state_slot(command_t *cmd, const char *arg)
+{
+   char state_path[PATH_MAX_LENGTH] = "";
+   char reply[128]                  = "";
+   char *end                        = NULL;
+   long slot                        = 0;
+   bool savestates_enabled          = core_info_current_supports_savestate();
+   bool ret                         = false;
+
+   if (!arg || !arg[0])
+   {
+      strlcpy(reply, "SAVE_STATE_SLOT", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   slot = strtol(arg, &end, 10);
+   snprintf(reply, sizeof(reply), "SAVE_STATE_SLOT %ld", slot);
+   if (!savestates_enabled || arg == end ||
+       (end && *end != '\0') || slot < -1)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (!runloop_get_savestate_path(state_path, sizeof(state_path), (int)slot) ||
+       core_serialize_size() == 0)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   if (slot == -1)
+      ret = content_auto_save_state(state_path);
+   else
+      ret = content_save_state(state_path, true);
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return ret;
+}
