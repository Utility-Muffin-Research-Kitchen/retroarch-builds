+bool command_set_disk_slot(command_t *cmd, const char *arg)
+{
+   char reply[128]               = "";
+   char *end                     = NULL;
+   runloop_state_t *runloop_st   = runloop_state_get_ptr();
+   rarch_system_info_t *sys_info = runloop_st
+      ? (rarch_system_info_t*)&runloop_st->system
+      : NULL;
+   unsigned long disk            = 0;
+   unsigned disk_count           = sys_info
+      ? disk_control_get_num_images(&sys_info->disk_control)
+      : 0;
+   bool was_ejected              = false;
+   bool ret                      = false;
+
+   if (!arg || !arg[0])
+   {
+      strlcpy(reply, "SET_DISK_SLOT", sizeof(reply));
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   disk = strtoul(arg, &end, 10);
+   snprintf(reply, sizeof(reply), "SET_DISK_SLOT %lu", disk);
+   if (!sys_info || arg == end || (end && *end != '\0') ||
+       disk_count == 0 || disk >= disk_count)
+   {
+      cmd->replier(cmd, reply, strlen(reply));
+      return false;
+   }
+
+   was_ejected = disk_control_get_eject_state(&sys_info->disk_control);
+   if (!was_ejected)
+      disk_control_set_eject_state(&sys_info->disk_control, true, false);
+   ret = disk_control_set_index(&sys_info->disk_control, (unsigned)disk, true);
+   if (!was_ejected)
+      disk_control_set_eject_state(&sys_info->disk_control, false, false);
+
+   cmd->replier(cmd, reply, strlen(reply));
+   return ret;
+}
