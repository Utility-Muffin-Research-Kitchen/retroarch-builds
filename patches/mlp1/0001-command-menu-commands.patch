+static int command_compare_frame_times(const void *left_ptr,
+      const void *right_ptr)
+{
+   retro_time_t left  = *(const retro_time_t*)left_ptr;
+   retro_time_t right = *(const retro_time_t*)right_ptr;
+
+   if (left < right)
+      return -1;
+   if (left > right)
+      return 1;
+   return 0;
+}
